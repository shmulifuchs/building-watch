#!/usr/bin/env python3
"""Simple Terminal commands for Building Watch; no third-party packages required."""
import argparse
import json
import os
import signal
import subprocess
import sys
import tempfile
import threading
from collections import Counter
from pathlib import Path
from urllib.parse import quote

from buildingwatch.annke import AnnkeClient, camera_client
from buildingwatch.config import validate
from buildingwatch.recorder import ClipMaker, Recorder, find_ffmpeg
from buildingwatch.reolink import CameraUnsupported, Connector, Spool, load_camera_settings
from buildingwatch.store import Store


ROOT = Path(__file__).resolve().parent
LOCAL = ROOT / '.local'
EXAMPLE = ROOT / 'buildings.pilot.example.json'


def read_config(path):
    raw = json.loads(path.read_text())
    if not isinstance(raw, dict) or set(raw) != {'buildings'} or not isinstance(raw['buildings'], list):
        raise ValueError('Configuration must contain only a buildings list')
    validate(raw['buildings'])
    return raw


def run(*args, capture=False):
    return subprocess.run([sys.executable, str(ROOT / 'building_watch.py'), *map(str, args)],
                          cwd=ROOT, check=True, text=True, capture_output=capture)


def local_directory():
    LOCAL.mkdir(mode=0o700, exist_ok=True)
    return LOCAL


def check():
    path = LOCAL / 'buildings.json'
    path = path if path.exists() else EXAMPLE
    buildings = validate(read_config(path)['buildings'])
    print('Building Watch configuration is valid.')
    print('Settings:', path)
    for building in buildings.values():
        mode = 'local only' if building.destination is None else 'WhatsApp route configured'
        print('  {} | {} | {}'.format(building.name, building.c['timezone'], mode))
    camera = LOCAL / 'camera.json'
    if camera.exists():
        settings = load_camera_settings(camera)
        if settings['building'] not in buildings:
            raise ValueError('Camera settings name an unknown building: ' + settings['building'])
        print('Camera: {} at {} for {} ({}). Run ./watch camera alongside ./watch start.'.format(
            settings.get('brand', 'reolink').capitalize(), settings['host'], settings['building'],
            settings.get('scheme', 'https')))
    else:
        print('Camera: not set up yet. Run python3 camera_setup.py --host <camera IP address>.')
    ffmpeg = find_ffmpeg()
    print('Recording and clips: ' + ('run ./watch record' if ffmpeg else 'install ffmpeg first (brew install ffmpeg)'))
    print('Live WhatsApp testing and continuous operation: still to be completed.')


def demo():
    folder = Path(tempfile.mkdtemp(prefix='practice-', dir=local_directory()))
    raw = read_config(EXAMPLE)
    # This practice run always uses local routes, even if someone edits the template.
    for building in raw['buildings']:
        building['destination'] = None
    config = folder / 'buildings.json'
    config.write_text(json.dumps(raw, indent=2) + '\n')
    database = folder / 'practice.sqlite3'
    base = ['--config', config, '--db', database]
    result = run(*base, 'replay', ROOT / 'demo.jsonl', '--until',
                 '2026-11-10T15:00:00-05:00', capture=True)
    alerts = json.loads(result.stdout)
    jobs = json.loads(run(*base, 'media-jobs', capture=True).stdout)
    audit = json.loads(run(*base, 'audit', capture=True).stdout)
    (folder / 'alerts.json').write_text(json.dumps(alerts, indent=2) + '\n')
    (folder / 'media-jobs.json').write_text(json.dumps(jobs, indent=2) + '\n')
    (folder / 'audit.json').write_text(json.dumps(audit, indent=2) + '\n')
    kinds = Counter(alert['type'] for alert in alerts)
    clips = [job for job in jobs if job['type'] == 'suspicious_activity']
    checks = {
        'First person detected': kinds['first_arrival'] == 1,
        'Possible last departure after inactivity': kinds['possible_last_departure'] == 1,
        'Camera outage and recovery': kinds['camera_offline'] > 0 and kinds['camera_recovered'] > 0,
        'Suspicious event opened and closed': kinds['suspicious_activity_started'] == 1
            and kinds['suspicious_activity_finished'] == 1,
        'Full 486-second event preserved in consecutive clip requests': bool(clips)
            and sum(job['duration_seconds'] for job in clips) == 486
            and all(0 < job['duration_seconds'] <= 60 for job in clips)
            and all(a['end'] == b['start'] for a, b in zip(clips, clips[1:]))
            and [job['part'] for job in clips] == list(range(1, len(clips) + 1))
            and clips[-1]['final_part'],
        'Conflicting event ID recorded': any(row['kind'] == 'id_collision' for row in audit),
        'Malformed input recorded without stopping': any(row['kind'] == 'quarantine_invalid_line'
                                                         for row in audit),
        'All alerts kept local': bool(alerts) and all(alert['delivery_status'] == 'local_only'
                                                   for alert in alerts),
    }
    print('Building Watch practice run — simulated events, no camera required.\n')
    for name, passed in checks.items():
        print('{}  {}'.format('PASS' if passed else 'FAIL', name))
    print('\nResults:', folder)
    print('This practice run creates recording requests only; ./watch record makes the real clips.')
    if not all(checks.values()):
        raise ValueError('One or more practice checks failed; inspect the saved results')


def start():
    folder = local_directory()
    config = folder / 'buildings.json'
    if not config.exists():
        # Exclusive creation preserves any existing local setup.
        with config.open('x') as stream:
            stream.write(EXAMPLE.read_text())
        config.chmod(0o600)
    read_config(config)
    spool = folder / 'camera-events.jsonl'
    spool.touch(exist_ok=True)
    print('Starting the local timer and event service. Press Control-C to stop.', flush=True)
    if not (folder / 'camera.json').exists():
        print('Camera not set up; run camera_setup.py, then ./watch camera in another Terminal.', flush=True)
    else:
        print('Run ./watch camera in another Terminal to feed camera events.', flush=True)
    print('Settings: ' + str(config), flush=True)
    args = [sys.executable, str(ROOT / 'building_watch.py'), '--config', str(config),
            '--db', str(folder / 'watch.sqlite3'), 'serve', '--input', str(spool)]
    os.execv(sys.executable, args)


def camera():
    settings = load_camera_settings(LOCAL / 'camera.json') if (LOCAL / 'camera.json').exists() else None
    if settings is None:
        raise ValueError('Camera not set up. Run: python3 camera_setup.py --host <camera IP address>')
    config = LOCAL / 'buildings.json'
    buildings = validate(read_config(config if config.exists() else EXAMPLE)['buildings'])
    if settings['building'] not in buildings:
        raise ValueError('Camera settings name an unknown building: ' + settings['building'])
    brand = settings.get('brand', 'reolink')
    client = camera_client(settings)
    connector = Connector(client, settings['building'], Spool(local_directory() / 'camera-events.jsonl'),
                          id_prefix=brand, detection=getattr(client, 'detection', None))
    stop = threading.Event()
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: stop.set())
    print('Watching the camera at {} for {}. Press Control-C to stop.'.format(
        settings['host'], settings['building']), flush=True)
    try:
        connector.run(stop)
    except CameraUnsupported as error:
        raise ValueError(str(error) + '. Turn on detection in the {} app.'.format(brand.capitalize())) from None
    finally:
        if brand == 'annke':
            client.close()
    print('Camera connector stopped.')


def record():
    """Keep rolling footage and turn footage requests into WhatsApp-ready clips."""
    path = LOCAL / 'camera.json'
    if not path.exists():
        raise ValueError('Camera not set up. Run: python3 camera_setup.py --host <camera IP address>')
    settings = load_camera_settings(path)
    client = camera_client(settings)
    if not isinstance(client, AnnkeClient):
        raise ValueError('./watch record currently supports ANNKE cameras only')
    ffmpeg = find_ffmpeg()
    if ffmpeg is None:
        raise ValueError('ffmpeg is required for recording. Install it with: brew install ffmpeg')
    database = LOCAL / 'watch.sqlite3'
    if not database.exists():
        raise ValueError('Start the service first with ./watch start')
    config = LOCAL / 'buildings.json'
    buildings = validate(read_config(config)['buildings'])
    building = buildings.get(settings['building'])
    if building is None:
        raise ValueError('Camera settings name an unknown building: ' + settings['building'])
    hours = settings.get('retention_hours', 12)
    # Each building gets its own folders, so footage can never reach another site's route.
    folder = quote(building.id, safe='')
    segments, clips = LOCAL / 'recordings' / folder, LOCAL / 'clips' / folder
    recorder = Recorder(client.rtsp_url(), segments, ffmpeg, retention_hours=hours)
    maker = ClipMaker(Store(str(database)), building.id, segments, clips, ffmpeg,
                      building_name=building.name, destination=building.destination)
    stop = threading.Event()
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: stop.set())
    worker = threading.Thread(target=recorder.run, args=(stop,), name='recorder', daemon=True)
    worker.start()
    print('Recording {} (keeping {} hours of video). Press Control-C to stop.'.format(
        settings['building'], hours), flush=True)
    maker.run(stop)
    worker.join(15)
    print('Recording stopped.')


def deliver(credentials):
    """Really sends queued alerts and clips to WhatsApp. Never used by demo or test."""
    config, database = LOCAL / 'buildings.json', LOCAL / 'watch.sqlite3'
    if not config.exists() or not database.exists():
        raise ValueError('Start the service first with ./watch start')
    if not Path(credentials).is_file():
        raise ValueError('WhatsApp credentials not found. Run: python3 whatsapp_setup.py --file ' + str(credentials))
    print('Sending queued alerts and clips to WhatsApp. Press Control-C to stop.', flush=True)
    os.execv(sys.executable, [sys.executable, str(ROOT / 'building_watch.py'), '--config', str(config),
                              '--db', str(database), 'deliver', '--credentials', str(credentials)])


def inspect(command):
    database = LOCAL / 'watch.sqlite3'
    if not database.exists():
        print('The local service has not been started. Use ./watch start to start it.')
        return
    run('--config', LOCAL / 'buildings.json', '--db', database, command)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['check', 'test', 'demo', 'start', 'camera', 'record', 'deliver', 'status', 'media', 'audit', 'publish'],
                        nargs='?', default='check')
    parser.add_argument('--once', action='store_true', help='Publish one dashboard update and exit')
    parser.add_argument('--credentials', default=str(LOCAL / 'whapi.json'),
                        help='Private WhatsApp credential file for ./watch deliver')
    args = parser.parse_args()
    try:
        if args.command == 'test':
            return subprocess.call([sys.executable, '-m', 'unittest', '-v'], cwd=ROOT)
        if args.command == 'check':
            check()
        elif args.command == 'demo':
            demo()
        elif args.command == 'start':
            start()
        elif args.command == 'camera':
            camera()
        elif args.command == 'record':
            record()
        elif args.command == 'deliver':
            deliver(args.credentials)
        elif args.command == 'publish':
            command = [sys.executable, str(ROOT / 'dashboard_sync.py')]
            if args.once:
                command.append('--once')
            return subprocess.call(command, cwd=ROOT)
        else:
            inspect({'status': 'outbox', 'media': 'media-jobs', 'audit': 'audit'}[args.command])
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print('Building Watch: ' + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
